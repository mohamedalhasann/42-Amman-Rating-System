# Copy to backend/.env. Never commit the real file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty ONLY for local SQLite development.
DATABASE_URL=
# DATABASE_URL=postgresql://fairly:password@localhost:5432/fairly?sslmode=disable
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
# Optional existing token instead of client credentials:
FORTYTWO_ACCESS_TOKEN=
# Only authorized image CDN hosts; redirects are rejected.
FORTYTWO_IMAGE_HOSTS=cdn.intra.42.fr

# Local account setup. No emails are sent externally in console mode.
ACCOUNT_ORIGIN=http://127.0.0.1:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Fairly <noreply@42amman.com>
# For deployment: HTTPS origin, real SMTP backend and approved sender.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# Per-IP limits allow for shared campus NAT; login also has a per-account limit.
AUTH_SETUP_IP_LIMIT=300
AUTH_LOGIN_IP_LIMIT=600
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_COMPLETE_IP_LIMIT=300
